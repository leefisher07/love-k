generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PromoCodeType {
  SINGLE
  COUPLE
}

enum PromoCodeStatus {
  ACTIVE      // 可用
  EXHAUSTED   // 用尽
  DISABLED    // 停用
}

model PromoCode {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(16)
  type        PromoCodeType    @default(SINGLE)
  status      PromoCodeStatus  @default(ACTIVE)

  maxUsage    Int              @default(1)    // 最大可用次数
  usageCount  Int              @default(0)    // 已使用次数

  batchNote   String?          @db.VarChar(200)
  createdAt   DateTime         @default(now())
  firstUsedAt DateTime?                       // 首次使用时间
  lastUsedAt  DateTime?                       // 最后使用时间

  reports     Report[]                        // 关联的报告记录

  @@index([status, type])
  @@index([code])
}

model Report {
  id           String       @id @default(uuid())
  promoCodeId  Int
  promoCode    PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  formData     Json         // 用户提交的表单数据
  reportData   Json         // AI返回的完整报告

  createdAt    DateTime     @default(now())

  @@index([promoCodeId, createdAt])
}

model SystemConfig {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(50)
  value       String    @db.Text
  description String?   @db.VarChar(200)
  updatedAt   DateTime  @updatedAt
}
